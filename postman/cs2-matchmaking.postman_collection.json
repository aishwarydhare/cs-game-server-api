{
  "info": {
    "name": "CS2 Matchmaking / Server-Join API",
    "description": "Auth (simulated), idempotency, create/list/get/join server flows.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "userId", "value": "player-1" },
    { "key": "serverId", "value": "" },
    { "key": "createKey", "value": "" }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/healthz", "host": ["{{baseUrl}}"], "path": ["healthz"] }
      }
    },
    {
      "name": "Create server",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.collectionVariables.set('createKey', 'create-' + Date.now());"]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('serverId', body.server.id);",
              "pm.test('has lobby', () => pm.expect(body.lobby.serverId).to.eql(body.server.id));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-user-id", "value": "{{userId}}" },
          { "key": "x-user-role", "value": "player" },
          { "key": "Idempotency-Key", "value": "{{createKey}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Dust2\",\n  \"requiredPlayers\": 4\n}"
        },
        "url": { "raw": "{{baseUrl}}/servers", "host": ["{{baseUrl}}"], "path": ["servers"] }
      }
    },
    {
      "name": "Create server (idempotent replay)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('replayed header is true', () => pm.expect(pm.response.headers.get('IDEMPOTENCY_REPLAYED')).to.eql('true'));",
              "pm.test('same status as original', () => pm.response.to.have.status(201));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-user-id", "value": "{{userId}}" },
          { "key": "x-user-role", "value": "player" },
          { "key": "Idempotency-Key", "value": "{{createKey}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Dust2\",\n  \"requiredPlayers\": 4\n}"
        },
        "url": { "raw": "{{baseUrl}}/servers", "host": ["{{baseUrl}}"], "path": ["servers"] }
      }
    },
    {
      "name": "Create server (key mismatch -> 409)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
              "pm.test('mismatch code', () => pm.expect(pm.response.json().error.code).to.eql('IDEMPOTENCY_KEY_MISMATCH'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-user-id", "value": "{{userId}}" },
          { "key": "x-user-role", "value": "player" },
          { "key": "Idempotency-Key", "value": "{{createKey}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Inferno\",\n  \"requiredPlayers\": 6\n}"
        },
        "url": { "raw": "{{baseUrl}}/servers", "host": ["{{baseUrl}}"], "path": ["servers"] }
      }
    },
    {
      "name": "Create server (odd players -> 400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-user-id", "value": "{{userId}}" },
          { "key": "x-user-role", "value": "player" },
          { "key": "Idempotency-Key", "value": "odd-{{$guid}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Nuke\",\n  \"requiredPlayers\": 5\n}"
        },
        "url": { "raw": "{{baseUrl}}/servers", "host": ["{{baseUrl}}"], "path": ["servers"] }
      }
    },
    {
      "name": "List servers (open only)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('returns servers array', () => pm.expect(pm.response.json().servers).to.be.an('array'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "x-user-id", "value": "{{userId}}" },
          { "key": "x-user-role", "value": "player" }
        ],
        "url": { "raw": "{{baseUrl}}/servers", "host": ["{{baseUrl}}"], "path": ["servers"] }
      }
    },
    {
      "name": "Get server by id",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.test('member count present', () => pm.expect(pm.response.json()).to.have.property('memberCount'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "x-user-id", "value": "{{userId}}" },
          { "key": "x-user-role", "value": "player" }
        ],
        "url": {
          "raw": "{{baseUrl}}/servers/{{serverId}}",
          "host": ["{{baseUrl}}"],
          "path": ["servers", "{{serverId}}"]
        }
      }
    },
    {
      "name": "Join server (player A)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('201 Created', () => pm.response.to.have.status(201));"]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "x-user-id", "value": "join-A" },
          { "key": "x-user-role", "value": "player" },
          { "key": "Idempotency-Key", "value": "joinA-first" }
        ],
        "url": {
          "raw": "{{baseUrl}}/servers/{{serverId}}/join",
          "host": ["{{baseUrl}}"],
          "path": ["servers", "{{serverId}}", "join"]
        }
      }
    },
    {
      "name": "Join server again as player A (-> 409 ALREADY_JOINED)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('409 Conflict', () => pm.response.to.have.status(409));",
              "pm.test('already joined code', () => pm.expect(pm.response.json().error.code).to.eql('ALREADY_JOINED'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "x-user-id", "value": "join-A" },
          { "key": "x-user-role", "value": "player" },
          { "key": "Idempotency-Key", "value": "joinA-second" }
        ],
        "url": {
          "raw": "{{baseUrl}}/servers/{{serverId}}/join",
          "host": ["{{baseUrl}}"],
          "path": ["servers", "{{serverId}}", "join"]
        }
      }
    }
  ]
}
