PORT=3000
# Host-facing URL. docker-compose maps Postgres to host port 5433 to avoid
# colliding with any local Postgres on 5432. Inside compose, the api talks to db:5432.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/matchmaking
# Used by the repo integration tests; defaults to a separate DB if unset.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/matchmaking_test
