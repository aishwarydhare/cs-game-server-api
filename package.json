{
  "name": "cs2-server-join-api",
  "version": "1.0.0",
  "description": "Matchmaking / server-join API for a CS2-style bomb-defusal game",
  "main": "dist/src/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "ts-node src/db/migrate.ts",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "test": "jest --selectProjects unit",
    "test:repo": "jest --selectProjects repo --runInBand",
    "test:all": "jest --runInBand",
    "format": "biome format --write .",
    "lint": "biome check .",
    "check": "biome check .",
    "prepare": "husky || true"
  },
  "dependencies": {
    "drizzle-orm": "^0.36.4",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.10",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.28.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.11",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "*.{ts,js,json}": ["biome check --write --no-errors-on-unmatched"]
  }
}
